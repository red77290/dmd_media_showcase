# =============================================================================
# DMD Media Showcase Server — Configuration (.env)
# =============================================================================
# Note: The server works out-of-the-box in ZERO-CONFIG mode using free keyless
# scrapers (ArcadeItalia MAME/CPS/Neo-Geo HTTPS, Libretro+Wikidata SPARQL &
# Archive.org, Apple iTunes, TVMaze, Jikan + AnimeThemes, and AniList).
# Add your free API keys below (or configure them live in the Web Admin UI at
# http://localhost:8890/) to unlock IGDB v4, ScreenScraper, TMDB, and TheTVDB!
#
# Credential Resolution Priority (3-Tier Vault):
#   1. Web Admin UI overrides persisted in ./data/server_config.json
#   2. Environment variables below (.env / docker-compose.yml)
#   3. Compiled CI/CD Native Vault (app/security/_prod_vault*.so in official releases)

# ── Server & Network ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8890
MDNS_ENABLED=true
MDNS_HOSTNAME=dmdmediashowcase
LOG_LEVEL=INFO
DEFAULT_LANG=fr

# ── CPU & Worker Pool Sizing (Zero-Overheat / Zero-Crash Elasticity) ─────────
# MAX_CONCURRENT_JOBS=0 means auto-bounded (1 on RPi/small VM <=2 vCPU, up to 4 on larger hosts)
MAX_CONCURRENT_JOBS=0
FFMPEG_THREADS_PER_JOB=1
WORKER_NICE_INCREMENT=10
MAX_QUEUE_SIZE=200

# ── Session, Persistence & Cache Lifecycle ────────────────────────────────────
# DMD_DATA_PATH persists server_config.json (including per-domain source_policies),
# dmd_profiles.json & seen_history.json across `docker compose down`
DMD_DATA_PATH=./data
CACHE_DIR=/tmp/dmd_media_showcase_cache
ON_DEMAND_CACHE_ENABLED=false
ON_DEMAND_CACHE_MAX_MB=0
BATCH_TTL_SECONDS=180
SESSION_TTL_SECONDS=1200
SERVER_MASTER_CLIP_MAX_S=30.0
PANORAMA_DURATION_S=4.0

# ── Multilingual Scrapers (Optional — Free API Keys) ─────────────────────────
# Note: Query-string & OAuth secrets (devpassword, sspassword, api_key,
# client_secret, Bearer tokens) are automatically scrubbed from stdout logs
# by SecretRedactingLogFilter (with httpx/httpcore clamped to WARNING).

# 1. IGDB v4 via Twitch OAuth2 (Retro, Arcade & Console Games — 200+ platforms,
#    instant shorthand/alias search like sf2x/3s/kof98, covers, artworks & trailers)
#    Register a free application at: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# 2. ScreenScraper.fr (Retro Arcade & Console Games — Détouré Marquees/Wheels,
#    Pixel-Art Snaps, short .mp4 Video Snaps, Multilingual FR/EN/ES/DE/IT)
#    Register a free account / dev credentials at: https://www.screenscraper.fr
SCREENSCRAPER_USER=
SCREENSCRAPER_PASS=
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASS=

# 3. TMDB (The Movie Database — Movies, TV Series & Anime localized titles/synopses)
#    Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# 4. TheTVDB v4 (Optional — TV Series & Anime localized metadata)
#    Get a free key at: https://thetvdb.com/api-information
TVDB_API_KEY=

# ── Optional API Guard & CI/CD Native Vault Build Key ────────────────────────
# Optional HTTP API key (`X-API-Key` / `Bearer`) if exposing Showcase outside LAN:
SHOWCASE_API_KEY=

# CI/CD Release Builds ONLY (`scripts/compile_prod_vault.py`):
# Derives a PBKDF2-HMAC-SHA256 + 16-byte random salt keystream and compiles a
# 3-way XOR native C extension (`app/security/_prod_vault*.so`), then deletes `.c`.
# Leave unset in local `.env` / `docker-compose` deployments.
# VAULT_MASTER_SECRET=
