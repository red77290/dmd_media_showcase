# =============================================================================
# DMD Media Showcase Server — Configuration (.env)
# =============================================================================
# Note: The server works out-of-the-box in ZERO-CONFIG mode using free keyless
# APIs (Steam Public API, TVMaze, Jikan, AnimeThemes) and built-in multilingual
# curated catalogs. Add your free API keys below to unlock full TMDB,
# ScreenScraper, and TheTVDB libraries!

# ── Server & Network ──────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8890
MDNS_ENABLED=true
MDNS_HOSTNAME=dmdmediashowcase
LOG_LEVEL=INFO
DEFAULT_LANG=fr

# ── CPU & Worker Pool Sizing (Zero-Overheat / Zero-Crash Elasticity) ─────────
# MAX_CONCURRENT_JOBS=0 means auto-bounded (1 on RPi/small VM <=2 vCPU, up to 4 on larger hosts)
MAX_CONCURRENT_JOBS=0
FFMPEG_THREADS_PER_JOB=1
WORKER_NICE_INCREMENT=10
MAX_QUEUE_SIZE=200

# ── Session & Cache Lifecycle (Stateless Auto-Purging) ────────────────────────
CACHE_DIR=/tmp/dmd_media_showcase_cache
BATCH_TTL_SECONDS=180
SESSION_TTL_SECONDS=1200
SERVER_MASTER_CLIP_MAX_S=15.0

# ── Multilingual Scrapers (Optional — Free API Keys) ─────────────────────────
# 1. TMDB (The Movie Database — Movies, TV Series & Anime localized titles/synopses)
#    Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# 2. ScreenScraper.fr (Retro Arcade & Console Games — Multilingual FR/EN/ES/DE/IT)
#    Register a free account at: https://www.screenscraper.fr
SCREENSCRAPER_USER=
SCREENSCRAPER_PASS=
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASS=

# 3. TheTVDB v4 (Optional — TV Series & Anime localized metadata)
TVDB_API_KEY=
