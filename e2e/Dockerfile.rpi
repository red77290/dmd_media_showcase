FROM rust:bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        perl \
        cmake \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY --from=arcadematrix_rpi Cargo.toml Cargo.lock VERSION build.rs ./
COPY --from=arcadematrix_rpi rust-rpi-rgb-led-matrix ./rust-rpi-rgb-led-matrix
COPY --from=arcadematrix_rpi src ./src
COPY --from=arcadematrix_rpi resources ./resources
COPY --from=arcadematrix_rpi api ./api
COPY --from=arcadematrix_rpi fonts ./fonts

RUN rm -rf ./rust-rpi-rgb-led-matrix/.git ./rust-rpi-rgb-led-matrix/rpi-led-matrix-sys/cpp-library/.git && \
    printf '\n[patch."https://github.com/AidanWallace/rust-rpi-rgb-led-matrix"]\npi-led-matrix = { path = "rust-rpi-rgb-led-matrix/rpi-led-matrix" }\n' >> Cargo.toml && \
    cargo build --release --bin arcadematrix

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ARCADEMATRIX_MOCK_MATRIX=1 \
    ARCADEMATRIX_E2E_INSPECT=1 \
    ARCADEMATRIX_HTTP_PORT=80

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        mosquitto \
        libstdc++6 \
    && pip install Pillow \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/arcadematrix_rpi
COPY --from=builder /build/target/release/arcadematrix /opt/arcadematrix_rpi/arcadematrix
COPY --from=arcadematrix_rpi fonts ./fonts
COPY --from=arcadematrix_rpi resources ./resources
COPY e2e/fixtures/generate_fixtures.py /opt/e2e/generate_fixtures.py
COPY e2e/entrypoint_rpi.sh /usr/local/bin/entrypoint_rpi.sh

RUN python3 /opt/e2e/generate_fixtures.py --mode dmd-sd --out /e2e_sd && \
    chmod +x /usr/local/bin/entrypoint_rpi.sh

EXPOSE 80 1883

HEALTHCHECK --interval=2s --timeout=3s --start-period=3s --retries=15 \
    CMD curl -fsS --max-time 2 http://127.0.0.1:80/api/e2e/state || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint_rpi.sh"]
