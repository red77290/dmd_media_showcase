FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ \
        curl \
        ca-certificates \
    && pip install Pillow \
    && rm -rf /var/lib/apt/lists/*

# Copy only ArcadeMatrix C++ sources & POSIX target harness (zero private files or .pio artifacts)
COPY --from=arcadematrix include /src/ArcadeMatrix/include
COPY --from=arcadematrix src /src/ArcadeMatrix/src
COPY --from=arcadematrix test/native/mock /src/ArcadeMatrix/test/native/mock
COPY --from=arcadematrix test/e2e_posix_target /src/ArcadeMatrix/test/e2e_posix_target

COPY e2e/fixtures/generate_fixtures.py /opt/e2e/generate_fixtures.py
COPY e2e/entrypoint_cpp.sh /usr/local/bin/entrypoint_cpp.sh

RUN CXX=g++ bash /src/ArcadeMatrix/test/e2e_posix_target/build.sh /usr/local/bin/arcadematrix_esp32_e2e && \
    python3 /opt/e2e/generate_fixtures.py --mode dmd-sd --out /e2e_sd && \
    chmod +x /usr/local/bin/entrypoint_cpp.sh && \
    rm -rf /src

EXPOSE 80 1883

ENTRYPOINT ["/usr/local/bin/entrypoint_cpp.sh"]
