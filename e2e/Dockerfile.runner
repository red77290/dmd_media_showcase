FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN pip install --upgrade pip && \
    pip install pytest httpx Pillow

WORKDIR /e2e
COPY e2e/runner /e2e/runner

CMD ["pytest", "-v", "-s", "--tb=short", "/e2e/runner/test_e2e_matrix.py"]
