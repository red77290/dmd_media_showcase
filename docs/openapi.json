    },
    {
      "name": "DMD Rotation Protocol",
      "description": "Two-step proactive double-batch rotation protocol (`POST /session` + `GET /batch`) and single-call convenience endpoint (`GET /random`) for ESP32 and Raspberry Pi DMDs."
    },
    {
      "name": "On-Demand & Voice Assistant",
      "description": "Priority queue endpoint (`POST /on-demand`) for voice assistants (Google Home, Alexa, Home Assistant) and interactive WebUI triggers."
    },
    {
      "name": "Assets & Streaming",
      "description": "Binary asset streaming for mini-jackets (`.rgb565`, `.png`), top-to-bottom scrolling panoramas (`jacket_stream_rgb565`, `marquee_stream_rgb565`, `snapshot_streams_rgb565`), and stabilized video trailers (`video_stream_rgb565`, `.gif`) with $O(1)$ truncation."
    }
