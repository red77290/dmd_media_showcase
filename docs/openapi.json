    "/api/v1/assets/{item_key}/{filename}": {
      "get": {
        "tags": [
          "Assets & Streaming"
        ],
        "summary": "Stream Media Asset",
        "description": "Serve or stream pre-rendered DMD assets (`.png`, `.rgb565`, `.gif`, `.rgb565.stream`).\nSupports $O(1)$ dynamic truncation via `?max_duration_s=` without re-running FFmpeg.",
        "operationId": "stream_media_asset_api_v1_assets__item_key___filename__get",
        "parameters": [
          {
            "name": "item_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Item Key"
            }
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Filename"
            }
          },
          {
            "name": "max_duration_s",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 30.0,
                  "minimum": 0.5
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional on-the-fly duration cap in seconds (zero re-encoding).",
              "title": "Max Duration S"
            },
            "description": "Optional on-the-fly duration cap in seconds (zero re-encoding)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
