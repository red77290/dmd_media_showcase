      }
    },
    "/api/v1/{domain}/session": {
      "post": {
        "tags": [
          "DMD Rotation Protocol"
        ],
        "summary": "Register Domain Session",
        "description": "Step 1 of the DMD Rotation Protocol:\nSent proactively by the DMD engine on boot or when WebUI settings are saved.\nRegisters the session and immediately enqueues `count` items into the bounded\nworker pool so `CurrentBatch` is warmed up before the engine's rotation turn.",
        "operationId": "register_domain_session_api_v1__domain__session_post",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "games",
                "movies",
                "series",
                "anime"
              ],
              "type": "string",
              "title": "Domain"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRegisterResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/{domain}/batch": {
      "get": {
        "tags": [
          "DMD Rotation Protocol"
        ],
        "summary": "Get Domain Batch",
        "description": "Step 2 of the DMD Rotation Protocol (\"Are you ready?\"):\nUltra-fast (< 2 ms) LAN status check called by the DMD right before its rotation turn.\n- If `status == \"ready\"`: returns the `N` pre-rendered items and rotates/schedules `NextBatch`.\n- If `status == \"warming\"`: allows the DMD to cleanly skip its rotation turn if other\n  engines are active in rotation.",
        "operationId": "get_domain_batch_api_v1__domain__batch_get",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "games",
                "movies",
                "series",
                "anime"
              ],
              "type": "string",
              "title": "Domain"
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Session ID returned by POST /api/v1/{domain}/session",
              "title": "Session Id"
            },
            "description": "Session ID returned by POST /api/v1/{domain}/session"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
